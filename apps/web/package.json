{
  "name": "@cutepet/web",
  "version": "0.1.0",
  "private": true,
  "description": "cutePet 用户端 Web（Vue3+Vite6，端口 18580）",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 18580 --strictPort",
    "build": "vue-tsc && vite build",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@cutepet/api-client": "workspace:*",
    "@cutepet/contracts": "workspace:*",
    "@cutepet/design-tokens": "workspace:*",
    "@cutepet/ui": "workspace:*",
    "pinia": "^2.1.0",
    "vue": "^3.5.0",
    "vue-router": "^4.3.0",
    "@vueuse/core": "^10.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.0.0"
  }
}
