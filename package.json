{
  "name": "cutepet",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "node scripts/run-logic-tests.mjs",
    "test:logic": "node scripts/run-logic-tests.mjs",
    "test:java": "node scripts/run-java-logic-tests.mjs",
    "gate": "node scripts/gate.mjs && node scripts/run-java-logic-tests.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "seed": "node scripts/db-reset.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
